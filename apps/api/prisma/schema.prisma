// CONTRATO (F0). Los agentes no editan este archivo: si necesitan un cambio, lo reportan.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Zona {
  RURAL
  URBANA
}

enum Ocupacion {
  COMERCIANTE
  AGRICULTOR
  TRANSPORTISTA
  OTRO
}

enum Gama {
  BAJA
  MEDIA
  ALTA
}

enum Vista {
  ASISTIDA
  ESTANDAR
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
}

enum TipoPago {
  CUOTA
  FRECUENTE
  RECIBO
}

enum EstadoPago {
  EXITOSO
  FALLIDO
}

enum TipoTransferencia {
  PROPIAS
  TERCEROS
  INTERBANCARIA
  CONTACTO
}

enum Rubro {
  LUZ
  AGUA
  TELEFONIA
  INTERNET
}

model Cliente {
  id                 Int       @id @default(autoincrement())
  dni                String    @unique @db.VarChar(8)
  nombre             String    @db.VarChar(60)
  apellido           String    @db.VarChar(60)
  edad               Int
  ocupacion          Ocupacion
  zona               Zona
  distrito           String    @db.VarChar(60)
  opsPresencialesMes Int
  opsDigitalesMes    Int
  gamaDispositivo    Gama
  diaPagoHabitual    Int // 1..28
  /// Clave simulada de 6 dígitos (datos ficticios; nunca se muestra ni se envía a la IA)
  claveDemo          String    @db.VarChar(6)
  vistaPreferida     Vista?
  primerIngreso      Boolean   @default(true)
  /// Reloj simulado para la demo ("Adelantar 30 días")
  fechaSimulada      DateTime  @default(now())
  pagosSinAyuda      Int       @default(0)
  esDemo             Boolean   @default(false)
  creadoEn           DateTime  @default(now())

  cuentas        Cuenta[]
  cuotas         Cuota[]
  frecuentes     Frecuente[]
  pagos          Pago[]
  transferencias Transferencia[]
  cashbacks      Cashback[]
  eventos        Evento[]
}

model Cuenta {
  id        Int     @id @default(autoincrement())
  clienteId Int
  numero    String  @unique @db.VarChar(20)
  tipo      String  @db.VarChar(30) // "Ahorro", "Ahorro emprendedor"
  saldo     Decimal @db.Decimal(12, 2)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pagos   Pago[]

  @@index([clienteId])
}

model Cuota {
  id          Int         @id @default(autoincrement())
  clienteId   Int
  credito     String      @db.VarChar(20) // número de crédito
  numero      Int // n.º de cuota
  totalCuotas Int
  monto       Decimal     @db.Decimal(12, 2)
  vencimiento DateTime
  estado      EstadoCuota @default(PENDIENTE)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, estado, vencimiento])
}

model Servicio {
  id            Int    @id @default(autoincrement())
  empresa       String @db.VarChar(60) // "Enosa", "EPS Grau", ...
  rubro         Rubro
  /// Regex que valida el código de suministro, p. ej. "^\\d{8}$"
  formatoCodigo String @db.VarChar(60)
  /// Texto de ayuda: dónde está el código en el recibo
  ayudaCodigo   String @db.VarChar(160)

  recibos    Recibo[]
  frecuentes Frecuente[]
}

model Recibo {
  id          Int      @id @default(autoincrement())
  codigo      String   @db.VarChar(30) // código de suministro
  servicioId  Int
  titular     String   @db.VarChar(120)
  monto       Decimal  @db.Decimal(12, 2)
  vencimiento DateTime
  pagado      Boolean  @default(false)
  /// Clave del objeto en R2 si es un recibo de demo con imagen
  imagenKey   String?  @db.VarChar(200)

  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@unique([servicioId, codigo, vencimiento])
  @@index([codigo])
}

model Frecuente {
  id         Int      @id @default(autoincrement())
  clienteId  Int
  alias      String   @db.VarChar(40) // "Luz de mamá"
  servicioId Int
  codigo     String   @db.VarChar(30)
  esPropio   Boolean  @default(true)
  creadoEn   DateTime @default(now())

  cliente  Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@unique([clienteId, servicioId, codigo])
}

model Pago {
  id             Int        @id @default(autoincrement())
  idempotencyKey String     @unique @db.VarChar(64)
  clienteId      Int
  cuentaId       Int
  tipo           TipoPago
  /// id de Cuota, id de Frecuente o id de Recibo según el tipo
  referenciaId   Int
  descripcion    String     @db.VarChar(120)
  monto          Decimal    @db.Decimal(12, 2)
  estado         EstadoPago
  conAyuda       Boolean    @default(false)
  /// Lo que se devolvió a la cuenta por este pago (cashback)
  cashback       Decimal    @default(0) @db.Decimal(10, 2)
  operacion      String     @db.VarChar(20) // n.º de operación de la constancia
  creadoEn       DateTime   @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id])

  @@index([clienteId, creadoEn])
}

/// Transferencias de la sección «Transferencias» (propias, a terceros, interbancarias y a contacto).
/// Las cuentas se guardan como números sueltos (sin llave foránea): el reinicio de la demo recrea las cuentas.
model Transferencia {
  id               Int               @id @default(autoincrement())
  idempotencyKey   String            @unique @db.VarChar(64)
  clienteId        Int
  tipo             TipoTransferencia
  cuentaOrigenId   Int
  /// Cuenta de Caja Piura que recibe (propias y a terceros); null si el dinero sale a otro banco o a un celular
  cuentaDestinoId  Int?
  destinoClienteId Int?
  /// Lo que escribió el cliente: n.º de cuenta, CCI o celular
  destino          String            @db.VarChar(30)
  nombreDestino    String            @db.VarChar(80)
  monto            Decimal           @db.Decimal(12, 2)
  glosa            String?           @db.VarChar(100)
  operacion        String            @db.VarChar(20)
  creadoEn         DateTime          @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([cuentaOrigenId])
  @@index([cuentaDestinoId])
}

/// Cashback abonado a la cuenta del cliente, uno por pago exitoso que lo ganó.
/// La cuenta va como número suelto (sin llave foránea), igual que en Transferencia: el reinicio de la demo recrea las cuentas.
model Cashback {
  id        Int      @id @default(autoincrement())
  clienteId Int
  cuentaId  Int
  pagoId    Int
  motivo    String   @db.VarChar(80)
  monto     Decimal  @db.Decimal(10, 2)
  creadoEn  DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, creadoEn])
  @@index([cuentaId])
}

model Evento {
  id            Int      @id @default(autoincrement())
  clienteId     Int?
  sesionId      String   @db.VarChar(40)
  pantalla      String   @db.VarChar(40)
  accion        String   @db.VarChar(40) // ver | tocar | completar | abandonar | error | ayuda
  flujo         String?  @db.VarChar(20) // CUOTA | FRECUENTE | RECIBO | LOGIN | ASISTENTE
  msDesdeInicio Int?
  ayudaUsada    Boolean  @default(false)
  creadoEn      DateTime @default(now())

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([pantalla, accion])
  @@index([sesionId])
}
