{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build -w apps/web"
  },
  "deploy": {
    "startCommand": "node scripts/iniciar-todo.mjs",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE"
  }
}
