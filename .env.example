# Copia este archivo como .env y completa los valores. No lo subas a git.

# Railway → servicio MySQL → Variables → MYSQL_PUBLIC_URL (para conectarte desde tu PC)
DATABASE_URL="mysql://usuario:clave@host:puerto/railway"

# Cualquier texto largo y aleatorio
SESSION_SECRET="cambia-esto-por-algo-largo"

# console.groq.com → API Keys
GROQ_API_KEY=""
# Modelos de Groq verificados el 2026-10-10 (scripts/verificar.ts)
GROQ_MODELO_TEXTO="qwen/qwen3.8-27b"
GROQ_MODELO_VISION="qwen/qwen3.8-27b"

# Cloudflare → R2 → Manage API tokens (permiso Object Read & Write sobre el bucket)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="caja-piura"

# Solo para apps/web: a dónde reenvía /api en desarrollo (en Vercel: URL de Railway)
API_URL="http://localhost:4317"
